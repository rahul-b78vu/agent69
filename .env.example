# Copy this file to backend/.env and adjust values.
# Never commit a real .env file.

APP_NAME=Agent 69 - Early Warning Agent
ENV=development
DEBUG=true

# SQLite is used by default so the prototype runs with zero setup.
# For production, point this at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://agent69:changeme@localhost:5432/agent69
DATABASE_URL=sqlite:///./agent69.db

# MUST be changed to a long random value outside local development.
SECRET_KEY=dev-only-insecure-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
